<html><!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Lamine Yamal — La Joya</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Anton&family=Space+Grotesk:wght@400;500;700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">
<style>
  :root{
    --bg:#090b14;
    --bg-alt:#0f1224;
    --panel:#12152a;
    --garnet:#a4013f;
    --garnet-bright:#d4185e;
    --blue:#0a4e94;
    --gold:#f0b90b;
    --text:#f3efe4;
    --text-dim:#8d92ab;
    --line:#232742;
  }

  *{margin:0;padding:0;box-sizing:border-box;}

  html{scroll-behavior:smooth;}

  body{
    background:var(--bg);
    color:var(--text);
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
  }

  ::selection{background:var(--gold);color:#111;}

  @media (prefers-reduced-motion: reduce){
    *{animation-duration:0.001ms !important; animation-iteration-count:1 !important; transition-duration:0.001ms !important;}
  }

  a{color:inherit;}

  .eyebrow{
    font-family:'JetBrains Mono',monospace;
    font-size:.72rem;
    letter-spacing:.18em;
    text-transform:uppercase;
    color:var(--gold);
  }

  /* ---------- NAV ---------- */
  nav{
    position:fixed;
    top:0;left:0;right:0;
    z-index:50;
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:1.1rem 6vw;
    background:rgba(9,11,20,.75);
    backdrop-filter:blur(10px);
    border-bottom:1px solid var(--line);
  }
  .nav-mark{
    font-family:'Anton',sans-serif;
    font-size:1.3rem;
    letter-spacing:.03em;
  }
  .nav-mark span{color:var(--gold);}
  .nav-links{
    display:flex;
    gap:2rem;
    font-family:'Space Grotesk',sans-serif;
    font-size:.85rem;
    text-transform:uppercase;
    letter-spacing:.06em;
  }
  .nav-links a{
    text-decoration:none;
    color:var(--text-dim);
    transition:color .25s;
  }
  .nav-links a:hover, .nav-links a:focus-visible{color:var(--gold);}
  @media (max-width:700px){ .nav-links{display:none;} }

  /* ---------- HERO ---------- */
  .hero{
    position:relative;
    min-height:100vh;
    display:flex;
    align-items:center;
    padding:6rem 6vw 4rem;
    background:
      radial-gradient(circle at 82% 18%, rgba(164,1,63,.35), transparent 45%),
      radial-gradient(circle at 10% 85%, rgba(10,78,148,.35), transparent 40%),
      var(--bg);
    isolation:isolate;
  }
  .hero-stripes{
    position:absolute; inset:0;
    background-image:repeating-linear-gradient(115deg, rgba(255,255,255,.025) 0 2px, transparent 2px 46px);
    z-index:-1;
  }
  .hero-grid{
    display:grid;
    grid-template-columns:1fr auto;
    gap:2rem;
    align-items:center;
    width:100%;
  }
  .hero-number{
    font-family:'Anton',sans-serif;
    font-size:clamp(9rem, 26vw, 20rem);
    line-height:.8;
    color:transparent;
    -webkit-text-stroke:2px var(--garnet-bright);
    text-shadow:0 0 60px rgba(212,24,94,.25);
    justify-self:end;
    user-select:none;
  }
  .hero-text .eyebrow{margin-bottom:1rem;}
  .hero-title{
    font-family:'Anton',sans-serif;
    font-size:clamp(2.6rem, 7vw, 5.4rem);
    line-height:.95;
    letter-spacing:.01em;
  }
  .hero-title .accent{color:var(--gold);}
  .hero-sub{
    margin-top:1.3rem;
    max-width:34ch;
    color:var(--text-dim);
    font-size:1.05rem;
    line-height:1.6;
  }
  .hero-tags{
    margin-top:2rem;
    display:flex;
    flex-wrap:wrap;
    gap:.6rem;
  }
  .tag{
    font-family:'JetBrains Mono',monospace;
    font-size:.75rem;
    padding:.4rem .8rem;
    border:1px solid var(--line);
    border-radius:100px;
    color:var(--text-dim);
  }
  @media (max-width:820px){
    .hero-grid{grid-template-columns:1fr;}
    .hero-number{justify-self:center; font-size:clamp(6rem,40vw,10rem);}
    .hero-text{order:2;text-align:center;}
    .hero-sub{margin-left:auto;margin-right:auto;}
    .hero-tags{justify-content:center;}
  }

  /* ---------- SECTION SHELL ---------- */
  section{
    padding:6rem 6vw;
    border-top:1px solid var(--line);
  }
  .section-head{
    display:flex;
    justify-content:space-between;
    align-items:flex-end;
    gap:2rem;
    margin-bottom:3rem;
    flex-wrap:wrap;
  }
  .section-title{
    font-family:'Space Grotesk',sans-serif;
    font-weight:700;
    font-size:clamp(1.8rem,3.6vw,2.6rem);
  }
  .section-note{
    max-width:40ch;
    color:var(--text-dim);
    font-size:.92rem;
    text-align:right;
  }
  @media (max-width:700px){ .section-note{text-align:left;} }

  /* ---------- FICHA / QUICK FACTS ---------- */
  .facts{
    background:var(--bg-alt);
  }
  .facts-grid{
    display:grid;
    grid-template-columns:repeat(auto-fit,minmax(160px,1fr));
    border:1px solid var(--line);
    border-radius:6px;
    overflow:hidden;
  }
  .fact{
    padding:1.6rem 1.4rem;
    border-right:1px solid var(--line);
    border-bottom:1px solid var(--line);
  }
  .fact:last-child{border-right:none;}
  .fact-label{
    font-family:'JetBrains Mono',monospace;
    font-size:.68rem;
    letter-spacing:.1em;
    text-transform:uppercase;
    color:var(--text-dim);
    margin-bottom:.5rem;
  }
  .fact-value{
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
    font-size:1.15rem;
  }

  /* ---------- HISTÓRIA ---------- */
  .story{
    background:var(--bg-alt);
  }
  .story-layout{
    display:grid;
    grid-template-columns:1fr 1.6fr;
    gap:3.5rem;
    align-items:start;
  }
  .story-side{
    position:sticky;
    top:6rem;
  }
  .story-origin-list{
    display:flex;
    flex-direction:column;
    gap:1.1rem;
    margin-top:1.5rem;
  }
  .story-origin-list li{
    list-style:none;
    border-left:2px solid var(--garnet-bright);
    padding-left:1rem;
  }
  .story-origin-list .o-place{
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
    font-size:.95rem;
  }
  .story-origin-list .o-desc{
    font-size:.8rem;
    color:var(--text-dim);
  }
  .story-body p{
    font-size:1.02rem;
    line-height:1.85;
    color:#d7d3c6;
    margin-bottom:1.4rem;
    max-width:64ch;
  }
  .story-body p:first-of-type::first-letter{
    font-family:'Anton',sans-serif;
    font-size:3.6rem;
    float:left;
    line-height:.8;
    padding:.1rem .5rem 0 0;
    color:var(--gold);
  }
  .story-pull{
    margin:2.2rem 0;
    padding:1.4rem 1.6rem;
    border-left:3px solid var(--gold);
    background:var(--panel);
    font-family:'Space Grotesk',sans-serif;
    font-size:1.05rem;
    font-style:italic;
    color:var(--text);
    max-width:64ch;
  }
  @media (max-width:860px){
    .story-layout{grid-template-columns:1fr;}
    .story-side{position:static;}
  }

  /* ---------- RULER TIMELINE (signature element) ---------- */
  .ruler{
    position:relative;
    padding-left:clamp(70px,10vw,140px);
  }
  .ruler::before{
    content:"";
    position:absolute;
    left:calc(clamp(70px,10vw,140px) / 2);
    top:0; bottom:0;
    width:2px;
    background:linear-gradient(var(--garnet-bright), var(--blue));
  }
  .ruler-item{
    position:relative;
    padding-bottom:3.4rem;
  }
  .ruler-item:last-child{padding-bottom:0;}
  .ruler-age{
    position:absolute;
    left:calc(-1 * clamp(70px,10vw,140px));
    width:clamp(70px,10vw,140px);
    top:-.3rem;
    text-align:right;
    padding-right:1.6rem;
    font-family:'Anton',sans-serif;
    font-size:clamp(2.2rem,4vw,3.4rem);
    color:var(--text-dim);
    line-height:1;
  }
  .ruler-age::after{
    content:"";
    position:absolute;
    right:-6px; top:50%;
    transform:translateY(-50%);
    width:12px;height:12px;
    border-radius:50%;
    background:var(--gold);
    box-shadow:0 0 0 4px var(--bg);
  }
  .ruler-card{
    background:var(--panel);
    border:1px solid var(--line);
    border-radius:6px;
    padding:1.4rem 1.6rem;
    max-width:640px;
  }
  .ruler-card .eyebrow{margin-bottom:.4rem;}
  .ruler-card h3{
    font-family:'Space Grotesk',sans-serif;
    font-size:1.15rem;
    margin-bottom:.5rem;
  }
  .ruler-card p{
    color:var(--text-dim);
    font-size:.92rem;
    line-height:1.55;
  }

  /* ---------- STATS ---------- */
  .stats{background:var(--bg-alt);}
  .stats-table{
    width:100%;
    border-collapse:collapse;
    font-family:'JetBrains Mono',monospace;
    font-size:.9rem;
  }
  .stats-table th, .stats-table td{
    text-align:left;
    padding:1rem 1rem;
    border-bottom:1px solid var(--line);
  }
  .stats-table th{
    color:var(--text-dim);
    text-transform:uppercase;
    font-size:.7rem;
    letter-spacing:.08em;
    font-weight:500;
  }
  .stats-table td.num, .stats-table th.num{text-align:right;}
  .stats-table tbody tr:hover{background:rgba(240,185,11,.05);}
  .stats-table td:first-child{
    font-family:'Space Grotesk',sans-serif;
    color:var(--text);
  }
  .stats-wrap{overflow-x:auto; border:1px solid var(--line); border-radius:6px;}
  .stats-foot{margin-top:1rem; font-size:.78rem; color:var(--text-dim);}

  /* ---------- HONOURS ---------- */
  .honours-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(230px,1fr));
    gap:1px;
    background:var(--line);
    border:1px solid var(--line);
  }
  .honour{
    background:var(--bg);
    padding:1.8rem 1.6rem;
    display:flex;
    flex-direction:column;
    gap:.6rem;
  }
  .honour-count{
    font-family:'Anton',sans-serif;
    font-size:2.4rem;
    color:var(--garnet-bright);
    line-height:1;
  }
  .honour-name{
    font-family:'Space Grotesk',sans-serif;
    font-weight:600;
  }
  .honour-detail{
    font-size:.82rem;
    color:var(--text-dim);
  }

  /* ---------- FOOTER ---------- */
  footer{
    padding:3rem 6vw;
    border-top:1px solid var(--line);
    display:flex;
    justify-content:space-between;
    align-items:center;
    flex-wrap:wrap;
    gap:1rem;
  }
  footer p{
    font-size:.8rem;
    color:var(--text-dim);
  }
  .footer-mark{
    font-family:'Anton',sans-serif;
    color:var(--text-dim);
  }
  .footer-mark span{color:var(--gold);}
</style>
</head>
<body>

<nav>
  <div class="nav-mark">10<span>·</span>YAMAL</div>
  <div class="nav-links">
    <a href="#ficha">Ficha</a>
    <a href="#historia">História</a>
    <a href="#trajetoria">Trajetória</a>
    <a href="#numeros">Números</a>
    <a href="#titulos">Títulos</a>
  </div>
</nav>

<header class="hero">
  <div class="hero-stripes"></div>
  <div class="hero-grid">
    <div class="hero-text">
      <p class="eyebrow">Página de fã · não oficial</p>
      <h1 class="hero-title">LAMINE<br>YAMAL<span class="accent">.</span></h1>
      <p class="hero-sub">Extremo do FC Barcelona e da Seleção Espanhola. Nascido em 2007, já é campeão europeu, campeão mundial e um dos jogadores mais precoces da história do futebol.</p>
      <div class="hero-tags">
        <span class="tag">Ala-direito</span>
        <span class="tag">Camisa 10 · Barcelona</span>
        <span class="tag">Camisa 19 · Espanha</span>
        <span class="tag">Pé esquerdo</span>
      </div>
    </div>
    <div class="hero-number" aria-hidden="true">10</div>
  </div>
</header>

<section class="facts" id="ficha">
  <div class="section-head">
    <h2 class="section-title">Ficha técnica</h2>
    <p class="section-note">Os dados essenciais de quem já é, aos 19 anos, uma das principais referências do futebol mundial.</p>
  </div>
  <div class="facts-grid">
    <div class="fact"><div class="fact-label">Nome completo</div><div class="fact-value">Lamine Yamal Nasraoui Ebana</div></div>
    <div class="fact"><div class="fact-label">Nascimento</div><div class="fact-value">13/07/2007</div></div>
    <div class="fact"><div class="fact-label">Local</div><div class="fact-value">Esplugues de Llobregat, Espanha</div></div>
    <div class="fact"><div class="fact-label">Altura</div><div class="fact-value">1,78 m</div></div>
    <div class="fact"><div class="fact-label">Clube</div><div class="fact-value">FC Barcelona</div></div>
    <div class="fact"><div class="fact-label">Posição</div><div class="fact-value">Ponta / Ala-direito</div></div>
  </div>
</section>

<section class="story" id="historia">
  <div class="section-head">
    <h2 class="section-title">De Rocafonda à camisa 10</h2>
    <p class="section-note">Antes das taças, uma infância simples entre dois bairros da Catalunha e uma família que sustentou o sonho.</p>
  </div>
  <div class="story-layout">
    <div class="story-side">
      <p class="eyebrow">Raízes</p>
      <ul class="story-origin-list">
        <li>
          <div class="o-place">Esplugues de Llobregat</div>
          <div class="o-desc">Cidade natal, na região metropolitana de Barcelona</div>
        </li>
        <li>
          <div class="o-place">Granollers</div>
          <div class="o-desc">Onde morava com a mãe e deu os primeiros toques na bola, no clube local La Torreta</div>
        </li>
        <li>
          <div class="o-place">Rocafonda, Mataró</div>
          <div class="o-desc">Bairro onde morava com o pai e passou boa parte da infância</div>
        </li>
        <li>
          <div class="o-place">La Masia</div>
          <div class="o-desc">Academia do Barcelona, onde ingressou aos 7 anos</div>
        </li>
      </ul>
    </div>
    <div class="story-body">
      <p>Lamine nasceu em 2007, filho de pai marroquino e mãe natural da Guiné Equatorial, dois imigrantes que construíram a vida na Catalunha com muito esforço. O próprio nome do jogador é uma homenagem: quando a família passava por um momento difícil, dois amigos chamados Lamine e Yamal os ajudaram, e o pai decidiu batizar o filho em agradecimento a ambos.</p>

      <p>Os pais se separaram quando ele tinha apenas 3 anos, e a infância foi dividida entre duas cidades: Granollers, com a mãe, e o bairro de Rocafonda, em Mataró, com o pai. Yamal costuma dizer que essa vivência entre lugares tão diferentes ajudou a moldar seu jeito de ser. A avó, Fátima, também teve papel central nesses anos e segue como uma das figuras mais importantes de sua vida.</p>

      <div class="story-pull">"Você vê seus pais trabalhando, sem poder estar sempre com você, e isso pesa. Eles também sentiram a pressão — eram jovens e precisavam criar um filho."</div>

      <p>A relação com a bola começou cedo, por volta dos 4 anos, no pequeno clube La Torreta, em Granollers, onde o técnico da equipe reconheceu seu talento e deixou que treinasse mesmo sem a família ter condições de pagar a mensalidade. Olheiros do Barcelona notaram o menino pouco depois, e aos 7 anos ele já vestia as cores azul e grená na La Masia, a mesma cantera que revelou nomes como Xavi, Iniesta e Messi.</p>

      <p>Na academia, Yamal queimou etapas mais rápido do que qualquer outro jogador de sua geração, disputando com frequência categorias muito acima da sua idade. Chamou tanta atenção que o técnico Xavi Hernández passou a chamá-lo para treinar com o elenco principal ainda como adolescente — um caminho que terminaria na estreia profissional em abril de 2023, aos 15 anos, e no início de uma das ascensões mais precoces da história do futebol.</p>
    </div>
  </div>
</section>

<section id="trajetoria">
  <div class="section-head">
    <h2 class="section-title">Uma carreira medida em idade</h2>
    <p class="section-note">Poucos jogadores têm sua trajetória contada em anos de vida em vez de temporadas. A régua abaixo segue os marcos por idade.</p>
  </div>
  <div class="ruler">
    <div class="ruler-item">
      <div class="ruler-age">15</div>
      <div class="ruler-card">
        <p class="eyebrow">Abril de 2023</p>
        <h3>Estreia pelo Barcelona</h3>
        <p>Com apenas 15 anos, estreia pela equipe principal do FC Barcelona, tornando-se um dos jogadores mais jovens da história do clube a debutar na LaLiga.</p>
      </div>
    </div>
    <div class="ruler-item">
      <div class="ruler-age">16</div>
      <div class="ruler-card">
        <p class="eyebrow">Setembro de 2023</p>
        <h3>Recorde pela Seleção Espanhola</h3>
        <p>Estreia pela Espanha e, na mesma partida, torna-se o jogador mais jovem da história a marcar um gol pela seleção principal.</p>
      </div>
    </div>
    <div class="ruler-item">
      <div class="ruler-age">16</div>
      <div class="ruler-card">
        <p class="eyebrow">Verão de 2024</p>
        <h3>Campeão europeu</h3>
        <p>É um dos destaques da Eurocopa de 2024, conquistada pela Espanha, e se torna o jogador mais jovem a marcar em uma semifinal do torneio.</p>
      </div>
    </div>
    <div class="ruler-item">
      <div class="ruler-age">17</div>
      <div class="ruler-card">
        <p class="eyebrow">Temporada 2024/2025</p>
        <h3>Camisa 10 e ano de consagração</h3>
        <p>Recebe a icônica camisa 10 do Barcelona e vive sua melhor temporada até então: LaLiga, Copa del Rey e Supercopa da Espanha, além do Troféu Kopa de melhor jovem do mundo.</p>
      </div>
    </div>
    <div class="ruler-item">
      <div class="ruler-age">18</div>
      <div class="ruler-card">
        <p class="eyebrow">Temporada 2025/2026</p>
        <h3>Líder técnico do Barça</h3>
        <p>Consolida-se como peça central do time culé, somando novo título de LaLiga e da Supercopa da Espanha ao lado dos companheiros catalães.</p>
      </div>
    </div>
    <div class="ruler-item">
      <div class="ruler-age">19</div>
      <div class="ruler-card">
        <p class="eyebrow">2026</p>
        <h3>Campeão do mundo</h3>
        <p>Disputa sua primeira Copa do Mundo, no Canadá, México e Estados Unidos, e conquista o título mundial com a Espanha, ampliando ainda mais sua coleção de troféus antes dos 20 anos.</p>
      </div>
    </div>
  </div>
</section>

<section class="stats" id="numeros">
  <div class="section-head">
    <h2 class="section-title">Números pelo Barcelona</h2>
    <p class="section-note">Jogos, gols e assistências na LaLiga, temporada a temporada.</p>
  </div>
  <div class="stats-wrap">
    <table class="stats-table">
      <thead>
        <tr>
          <th>Temporada</th>
          <th class="num">Jogos</th>
          <th class="num">Gols</th>
          <th class="num">Assistências</th>
        </tr>
      </thead>
      <tbody>
        <tr><td>2022/2023</td><td class="num">1</td><td class="num">0</td><td class="num">0</td></tr>
        <tr><td>2023/2024</td><td class="num">37</td><td class="num">5</td><td class="num">5</td></tr>
        <tr><td>2024/2025</td><td class="num">35</td><td class="num">9</td><td class="num">13</td></tr>
        <tr><td>2025/2026</td><td class="num">19</td><td class="num">10</td><td class="num">8</td></tr>
      </tbody>
    </table>
  </div>
  <p class="stats-foot">Dados de LaLiga por temporada, com base em estatísticas públicas. A temporada em curso pode ainda ser atualizada.</p>
</section>

<section id="titulos">
  <div class="section-head">
    <h2 class="section-title">Títulos</h2>
    <p class="section-note">Pelo clube e pela seleção, uma coleção já invejável para quem ainda não completou 20 anos.</p>
  </div>
  <div class="honours-grid">
    <div class="honour">
      <div class="honour-count">3×</div>
      <div class="honour-name">LaLiga</div>
      <div class="honour-detail">2022/23 · 2024/25 · 2025/26 — FC Barcelona</div>
    </div>
    <div class="honour">
      <div class="honour-count">1×</div>
      <div class="honour-name">Copa del Rey</div>
      <div class="honour-detail">2024/25 — FC Barcelona</div>
    </div>
    <div class="honour">
      <div class="honour-count">2×</div>
      <div class="honour-name">Supercopa da Espanha</div>
      <div class="honour-detail">2024/25 · 2025/26 — FC Barcelona</div>
    </div>
    <div class="honour">
      <div class="honour-count">2×</div>
      <div class="honour-name">Troféu Joan Gamper</div>
      <div class="honour-detail">2023 · 2025 — FC Barcelona</div>
    </div>
    <div class="honour">
      <div class="honour-count">1×</div>
      <div class="honour-name">Eurocopa</div>
